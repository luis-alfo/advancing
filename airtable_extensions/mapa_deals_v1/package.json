{
  "name": "@advancing/mapa-deals-extension",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint frontend",
    "build:geo": "node scripts/build-geo.mjs",
    "preview:build": "esbuild preview/preview.jsx --bundle --outfile=preview/preview.bundle.js --alias:@airtable/blocks/interface/ui=./preview/mock-sdk.js --define:process.env.NODE_ENV='\"development\"'",
