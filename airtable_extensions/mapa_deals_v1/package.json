    "preview:serve": "python3 preview/serve.py",
    "preview:tmp": "bash scripts/preview-tmp.sh"
  },
  "dependencies": {
    "@airtable/blocks": "interface-alpha",
    "d3-composite-projections": "^1.4.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "autoprefixer": "^10.4.20",
    "css-loader": "^6.11.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.17"
  },
